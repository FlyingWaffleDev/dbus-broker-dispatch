#!/sbin/openrc-run

description="D-Bus user session message bus (dbus-broker-dispatch)"
supervisor=supervise-daemon
command="/usr/bin/dbus-broker-dispatch"
command_args="--scope=user --foreground --syslog --ready-fd=3"
notify="fd:3"
respawn_delay=1
respawn_max=5
respawn_period=60

extra_started_commands="reload"

start_pre() {
	[ -n "${XDG_RUNTIME_DIR}" ] || {
		eerror "XDG_RUNTIME_DIR is required for the D-Bus user service"
		return 1
	}
}

# The dispatcher removes its own socket on exit; see /etc/init.d/dbus.

reload() {
	ebegin "Reloading D-Bus user-session configuration"
	supervise-daemon "${RC_SVCNAME}" --signal HUP
	eend $?
}
