#!/sbin/openrc-run

description="D-Bus system message bus (dbus-broker-dispatch)"
supervisor=supervise-daemon
command="/usr/bin/dbus-broker-dispatch"
command_args="--scope=system --foreground --syslog --ready-fd=3 ${dbus_dispatch_args}"
# The dispatcher reports on fd 3 once the listener is live, so dependent
# services only start when they can connect.
notify="fd:3"
# The dispatcher exits when dbus-broker dies; restart the pair.
respawn_delay=1
respawn_max=5
respawn_period=60

extra_started_commands="reload"

depend() {
	need localmount
	after bootmisc
	before net
}

start_pre() {
	/usr/bin/dbus-uuidgen --ensure=/etc/machine-id || return 1
	# The dispatcher binds /run/dbus/system_bus_socket itself.
	checkpath --directory --mode 0755 /run/dbus || return 1
}

# The dispatcher removes the socket it created when it exits. Removing it here
# as well would delete a socket belonging to another instance whenever a start
# failed because one was already running.

reload() {
	ebegin "Reloading D-Bus system configuration"
	supervise-daemon "${RC_SVCNAME}" --signal HUP
	eend $?
}
