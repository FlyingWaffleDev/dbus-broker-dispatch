#!/sbin/openrc-run
# OpenRC service for dbus-broker-openrc-launch.
name="D-Bus system message bus"
command="/usr/bin/dbus-broker-openrc-launch"
command_args="--scope=system --foreground"
command_background="no"
pidfile="/run/dbus/dbus-broker-openrc-launch.pid"

depend() {
    need localmount
    before net
}

start_pre() {
    checkpath --directory --mode 0755 --owner messagebus:messagebus /run/dbus || return 1
}
